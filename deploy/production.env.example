NODE_ENV=production
PORT=5000
HOST=127.0.0.1
APP_URL=https://REPLACE_WITH_YOUR_DOMAIN
API_PUBLIC_URL=https://REPLACE_WITH_YOUR_DOMAIN
SERVE_FRONTEND=true
TRUST_PROXY=1
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/footprintx
ENCRYPTION_KEYS=k1:REPLACE_WITH_RANDOM_64_HEX
INDEX_KEY=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to API_PUBLIC_URL/api/connections/google/callback
GMAIL_SCOPE_MODE=metadata
THREAT_FEEDS=phishing_database
THREAT_SYNC_INTERVAL_HOURS=12
BREACH_PROVIDER=xposedornot
DEV_SYNTHETIC_DATA=false
BILLING_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CONTACT_TO=
LOG_LEVEL=info
RUN_WORKER=true
RUN_SCHEDULER=true
