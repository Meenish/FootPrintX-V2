{
  "name": "footprintx",
  "private": true,
  "version": "2.0.0",
  "description": "FootprintX - Secure Your Digital Past. Protect Your Online Future.",
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "extension"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "setup": "node backend/scripts/setup-env.mjs",
    "migrate": "npm run migrate -w backend",
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w backend",
    "dev:web": "npm run dev -w frontend",
    "build": "npm run build -w frontend && npm run build -w extension -- --zip",
    "start": "npm start -w backend",
    "test": "npm test -w shared && npm test -w backend && npm test -w extension",
    "test:pg": "node scripts/test-postgres.mjs",
    "test:e2e": "node --test --test-concurrency=1 e2e/*.test.mjs",
    "lint": "eslint .",
    "audit:deps": "npm audit --omit=dev",
    "eval:detection": "npm run eval:detection -w shared",
    "preflight": "node scripts/preflight.mjs",
    "build:production": "node scripts/build-production.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "playwright-core": "^1.49.1"
  },
  "type": "module",
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
