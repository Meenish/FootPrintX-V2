# FootprintX backend configuration. Copy to backend/.env (or run `npm run setup`,
# which generates random keys for you). Never commit a real .env file.
# Every variable is documented in docs/DEPLOYMENT.md.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Public URL of the web app (used in emails and redirects).
APP_URL=http://localhost:5173
# Public URL of this API (used for the Google OAuth redirect and by the extension).
API_PUBLIC_URL=http://localhost:5000
# Extra web origins allowed to call the API with credentials (comma-separated).
CORS_ORIGINS=
# Browser-extension origins allowed by CORS (optional; extensions use Bearer tokens).
EXTENSION_ORIGINS=
# Number of trusted reverse-proxy hops (for client IPs / rate limits). 0 = none.
TRUST_PROXY=0
# Serve frontend/dist from this process (single-origin deployment).
SERVE_FRONTEND=false
LOG_LEVEL=info
# Run the scan worker / periodic scheduler inside the API process.
RUN_WORKER=true
RUN_SCHEDULER=true

# --- Database ----------------------------------------------------------------
# PostgreSQL in any real deployment, e.g. postgres://footprintx:pass@localhost:5432/footprintx
# For zero-setup local development: pglite:./data/pglite  (embedded PostgreSQL; not for production)
DATABASE_URL=pglite:./data/pglite

# --- Secrets (generate with `npm run setup`) ----------------------------------
# AES-256-GCM key ring: "id:64-hex[,older-id:64-hex]". First key encrypts; all keys decrypt.
ENCRYPTION_KEYS=
# 64 hex chars; HMAC key for blind indexes/de-dup hashes. Must differ from encryption keys.
INDEX_KEY=

# --- Google / Gmail ------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to ${API_PUBLIC_URL}/api/connections/google/callback
GOOGLE_REDIRECT_URI=
# metadata (least privilege, default) | readonly (deeper search-based discovery)
GMAIL_SCOPE_MODE=metadata
SCAN_MAX_MESSAGES=1500
# Automatic re-scan interval for connected Gmail mailboxes (hours, 0 = off).
MONITOR_INTERVAL_HOURS=24
# Development only: enables the labelled synthetic mailbox. Rejected in production.
DEV_SYNTHETIC_DATA=false

# --- Breach intelligence -------------------------------------------------------
# none | xposedornot (free, low volume, no key) | hibp (paid API key)
BREACH_PROVIDER=none
HIBP_API_KEY=
BREACH_INCLUDE_SENSITIVE=false
BREACH_RECHECK_MIN_HOURS=24

# --- Website threat intelligence -----------------------------------------------
# Comma-separated built-in feeds: phishing_database
THREAT_FEEDS=
# Optional local file of hostnames (one per line) — useful offline or for tests.
THREAT_FEED_FILE=
THREAT_SYNC_INTERVAL_HOURS=12
# Older datasets are reported as "unknown", never as clean.
THREAT_DATASET_MAX_AGE_HOURS=72
THREAT_FEED_MAX_ENTRIES=500000

# --- Plans / billing -------------------------------------------------------------
# disabled | development (test checkout, no payment; rejected in production)
BILLING_MODE=disabled
# Price in minor units (14900 = ₹149.00). "proposed" is shown until approved.
PREMIUM_PRICE_MINOR=14900
PREMIUM_CURRENCY=INR
PREMIUM_PRICE_STATUS=proposed
PREMIUM_INTERVAL=month
DEV_PREMIUM_DAYS=30

# --- Email (optional notifications + password reset) -----------------------------
CONTACT_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SECURITY_EMAILS_PER_DAY=5
